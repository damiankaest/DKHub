# Nach .env kopieren. start.ps1 liest die Datei bei jedem Start.
# Entweder ein Passwort setzen ...
DKHUB_ADMIN_PASSWORD=
# ... oder die Abfrage abschalten: Dann darf jeder im Netzwerk alles aendern und Container installieren.
DKHUB_NO_AUTH=0

DKHUB_ENABLE_DIRECTOR=0
DKDIRECTOR_BIND_IP=192.168.1.50
